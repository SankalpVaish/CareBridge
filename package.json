{
  "name": "rural-specialty-care-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Base web app for exploring rural specialty-care access. Three workstreams (Care & Cost, Find & Trust, Coordinate) share one data contract.",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:watch": "nodemon server/index.js",
    "dev:all": "concurrently -n api,web -c blue,green \"npm:server:watch\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
